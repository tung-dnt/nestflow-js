{
  "name": "nestflow-js",
  "version": "0.1.15",
  "private": false,
  "packageManager": "pnpm@12.23.0",
  "description": "Workflow and state machine for NestJS",
  "license": "MIT",
  "author": "Thomas Do (tung-dnt)",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/core/index.js",
  "types": "./dist/core/index.d.ts",
  "exports": {
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js",
      "default": "./dist/core/index.js"
    },
    "./exception": {
      "types": "./dist/exception/index.d.ts",
      "import": "./dist/exception/index.js",
      "default": "./dist/exception/index.js"
    },
    "./adapter": {
      "types": "./dist/adapter/index.d.ts",
      "import": "./dist/adapter/index.js",
      "default": "./dist/adapter/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "vp pack",
    "check": "vp check packages scripts test vite.config.ts",
    "test": "vp test",
    "test:watch": "vp test watch",
    "test:cov": "vp test run --coverage",
    "test:e2e": "vp test test/e2e",
    "typecheck": "vp check --no-fmt --no-lint packages",
    "verify:package": "node scripts/verify-package.mjs",
    "verify:lambda": "pnpm --filter lambda-order-state-machine run verify:lambda",
    "prepublishOnly": "pnpm run build"
  },
  "peerDependencies": {
    "@nestjs/common": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@aws/durable-execution-sdk-js": "1.1.0",
    "@aws/durable-execution-sdk-js-testing": "1.1.1",
    "@nestjs/common": "^12.6.2",
    "@nestjs/core": "^12.6.2",
    "@nestjs/platform-express": "^12.6.2",
    "@nestjs/testing": "^12.6.2",
    "@types/node": "22.20.7",
    "@vitest/coverage-v8": "5.1.1",
    "reflect-metadata": "^0.2.2",
    "tsc-alias": "^1.8.16",
    "typescript": "5.9.3",
    "vite-plus": "1.8.0"
  },
  "typesVersions": {
    "*": {
      "core": [
        "./dist/core/index.d.ts"
      ],
      "exception": [
        "./dist/exception/index.d.ts"
      ],
      "adapter": [
        "./dist/adapter/index.d.ts"
      ]
    }
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "keywords": [
    "nestjs",
    "workflow",
    "state-machine",
    "fsm",
    "finite-state-machine",
    "typescript",
    "event-driven",
    "process-automation",
    "business-process",
    "workflow-engine",
    "state-management",
    "transition",
    "nodejs",
    "serverless",
    "orchestration",
    "lambda",
    "tree-shakable",
    "distributed",
    "state",
    "machine",
    "nestjs serverless workflow",
    "nestflow-js",
    "nestjs workflow",
    "nestjs state machine",
    "state machine",
    "checkpoint",
    "replay",
    "restore"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/tung-dnt/nestflow-js"
  },
  "bugs": {
    "url": "https://github.com/tung-dnt/nestflow-js/issues"
  },
  "homepage": "https://nestflow.organit.dev"
}
