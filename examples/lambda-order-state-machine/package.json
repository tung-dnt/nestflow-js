{
  "name": "lambda-order-state-machine",
  "version": "1.0.0",
  "private": true,
  "author": "Thomas Do (tung-dnt)",
  "license": "MIT",
  "description": "Complete AWS Lambda example using nestflow-js with Durable Execution and DynamoDB",
  "type": "module",
  "main": "dist/lambda.mjs",
  "scripts": {
    "compile": "tsc -p tsconfig.build.json",
    "build": "pnpm run compile && node scripts/build.mjs",
    "synth": "pnpm run build && cdk synth",
    "deploy": "pnpm run build && cdk deploy",
    "deploy:dev": "pnpm run build && cdk deploy -c stage=dev",
    "deploy:prod": "pnpm run build && cdk deploy -c stage=prod",
    "diff": "pnpm run build && cdk diff",
    "destroy": "pnpm run build && cdk destroy",
    "start": "pnpm run compile && node --env-file-if-exists=.env .build/src/main.js",
    "typecheck": "tsc --noEmit",
    "verify:lambda": "pnpm run build && node scripts/verify-lambda.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.958.0",
    "@aws-sdk/client-lambda": "^3.1177.0",
    "@aws-sdk/lib-dynamodb": "^3.958.0",
    "@aws/durable-execution-sdk-js": "1.1.0",
    "@nestjs/common": "^12.6.2",
    "@nestjs/core": "^12.6.2",
    "@nestjs/platform-express": "^12.6.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "dynamodb-toolbox": "^2.7.4",
    "nestflow-js": "workspace:*",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuidv7": "^1.1.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.159",
    "@types/node": "22.20.7",
    "aws-cdk": "2.1149.0",
    "aws-cdk-lib": "^2.180.0",
    "constructs": "^10.4.0",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=26"
  },
  "keywords": [
    "nestjs",
    "serverless",
    "workflow",
    "state-machine",
    "lambda",
    "durable-execution",
    "dynamodb",
    "aws"
  ]
}
